# Simhastha 2028 - Sprint 1 local dev environment
#
# Copy this file to `.env` at the repo root:
#   cp .env.example .env
#
# Used by infra/docker-compose.yml when run with --env-file, e.g.:
#   docker compose --env-file .env -f infra/docker-compose.yml up --build
#
# All values below have working defaults baked into docker-compose.yml, so
# the stack runs even without a .env file — copy this only if you want to
# change credentials/ports locally.

# --- Postgres (postgis/postgis image) ---
POSTGRES_DB=simhastha
POSTGRES_USER=simhastha
POSTGRES_PASSWORD=simhastha_dev_password

# --- API ---
# Dev-only secret. Backend Architect: this is NOT a production secret
# management setup (out of scope this sprint - docker-compose only).
API_SECRET_KEY=dev-secret-change-me

# --- Web ---
# Must match the API's exposed host port below (localhost:8000 by default).
NEXT_PUBLIC_API_URL=http://localhost:8000
