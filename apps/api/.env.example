# Copy to apps/api/.env only if you run the API directly on your host
# (outside docker-compose) e.g. `uvicorn app.main:app --reload`.
# When running via `docker-compose up`, infra/docker-compose.yml already
# injects these as container environment variables pointing at the
# `postgres` / `redis` service names — you do not need this file for that.

APP_NAME=Simhastha 2028 API
ENV=development
DATABASE_URL=postgresql+psycopg2://simhastha:simhastha_dev_password@localhost:5432/simhastha
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
